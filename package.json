{
  "name": "catjam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Minimalist markdown not defteri — kedi maskotlu, tamamen lokal (Obsidian tarzi)",
  "author": "attilayener",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "app:dev": "electron .",
    "exe": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "app.catjam.notes",
    "productName": "Cat Jam",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icons/cat-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Cat Jam"
    }
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@xenova/transformers": "^2.17.2",
    "codemirror": "^6.0.2",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.17",
    "katex": "^0.19.0",
    "lucide": "^1.57.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0"
  }
}
